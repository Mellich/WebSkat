{
  "name": "webskat",
  "private": true,
  "version": "0.7.0",
  "description": "Browser-only, peer-to-peer multiplayer Skat (3 players, Geberskat for 4-6).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/make-assets.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/make-assets.mjs --if-missing",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "assets": "node scripts/make-assets.mjs",
    "publish:pages": "node scripts/publish-gh-pages.mjs",
    "relay": "node scripts/relay.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@trystero-p2p/ws-relay": "^0.26.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "trystero": "^0.26.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
