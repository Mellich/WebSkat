# Copy to .env.local and adjust. Every VITE_* value ends up in the public JS bundle.

# Signaling strategy: nostr (default, public relays) or ws-relay (self-hosted, see `npm run relay`)
VITE_SIGNALING=nostr
# Optional comma-separated Nostr relay URLs (wss://...) replacing the library defaults
VITE_RELAY_URLS=
# Required when VITE_SIGNALING=ws-relay, e.g. wss://relay.example.com
VITE_RELAY_URL=

# Optional TURN server for players behind strict NATs
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CREDENTIAL=
